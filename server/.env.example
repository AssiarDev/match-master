# Token d'accès à l'API Sportmonks
API_TOKEN=your_sportmonks_api_token

# Port d'écoute du serveur Express
PORT=3000

# URL du client (dev)
URL_SERVER_CLIENT=http://localhost:5173

# URL de base de l'API Sportmonks
URL_API=https://api.sportmonks.com/v3/football

# Clé secrète pour signer les tokens JWT
SECRET_KEY=your_secret_key

# Clé secrète pour les sessions Express
SESSION_KEY=your_session_key

# Environnement (development | production)
NODE_ENV=development

# URL de connexion à la base de données PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/match_master?schema=public

# URL du client en production
URL_PROD_CLIENT=https://your-app.netlify.app

# Nom du site Netlify (production uniquement)
NETLIFY_SITE_NAME=your-netlify-site-name
