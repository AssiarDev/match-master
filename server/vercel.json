{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npm run vercel-build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "cron": [
    {
      "path": "/cron/update-db/players",
      "schedule": "0 3 * * *"
    }, 
    {
      "path": "/cron/update-db/trainers",
      "schedule": "0 3 * * *"
    }
  ]
}