{
  "name": "server",
  "version": "1.0.0",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "dev": "dotenv -e .env.development -- npx tsx watch server.ts",
    "prod": "dotenv -e .env.production -- npx tsx server.ts",
    "build": "tsc",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "postinstall": "prisma generate",
    "prettier:fix": "npx prettier . --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.21",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^8.0.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "prettier": "3.8.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^6.7.0",
    "typescript": "^6.0.2"
  }
}
